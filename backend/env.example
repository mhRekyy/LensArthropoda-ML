# ============================================================
# LensArthropoda — Backend Environment Variables
# Salin file ini menjadi .env lalu isi dengan kredensial Anda
#   cp env.example .env
# ============================================================

# Gemini API Key — dapatkan GRATIS di: https://aistudio.google.com/app/apikey
GEMINI_API_KEY=your_gemini_api_key_here

# Path model & metadata (jangan diubah jika tidak perlu)
MODEL_PATH=./artifacts/insect_model.pt
METADATA_PATH=./artifacts/metadata.json
